# Copy to `.dev.vars` (untracked) for local runs. Secret values stay empty here.

# Required, and not set in wrangler.toml: a missing value makes the gateway fail closed.
ENVIRONMENT=development

# Secret names come from docs/cloud-plan.md ("Security requirements" > Secrets).
# Use separate values per environment (staging, production, Paddle sandbox and live).

# Ed25519 private key (PKCS8, base64) that signs access tokens; rotated through `kid` and the JWKS.
TOKEN_SIGNING_KEY=
# Keyed HMAC for one-time email codes and other stored code hashes.
CODE_HMAC_KEY=
# HMAC key for the per-account pseudonym sent upstream as `user`.
UPSTREAM_PSEUDONYM_KEY=
# Master key for the rotating salt of the sign-in and rate-limit counters.
RATE_LIMIT_SALT_KEY=
# Google OAuth client secret (the client id is a public var).
GOOGLE_CLIENT_SECRET=
# Email provider key used to send one-time codes and notifications.
EMAIL_PROVIDER_API_KEY=
# Inference provider key (first production provider: Groq).
GROQ_API_KEY=
# Paddle API key and webhook secret (sandbox and live are never mixed).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Optional: the previous webhook secret, accepted only during a rotation.
PADDLE_WEBHOOK_SECRET_PREVIOUS=
# Not secrets, so they live in wrangler.toml [vars] per environment: the Paddle price ids (they differ between
# sandbox and live) and, optionally, the credits of one budget window (placeholders, verify before launch):
#   PADDLE_PRICE_PLUS_MONTHLY, PADDLE_PRICE_PLUS_SEMESTER, PLUS_MONTHLY_WINDOW_CREDITS, PLUS_SEMESTER_WINDOW_CREDITS
# and PADDLE_CHECKOUT_HOSTS (comma-separated host names the hosted checkout may be on; the checkout URL is pinned to them).
# Outside development the billing module refuses to start with a missing or placeholder price id or checkout host.
