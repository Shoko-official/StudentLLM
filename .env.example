# Provider configuration is read at runtime and must not be committed with values.
# On Windows, set NVIDIA_API_KEY in the User environment scope.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-4b
# Optional browser chat endpoint; use the same-origin Vite proxy when LM Studio CORS is disabled.
VITE_LM_STUDIO_BASE_URL=/lm-studio/v1
VITE_LM_STUDIO_MODEL=qwen/qwen3-4b

# Optional local faster-whisper sidecar used after a recording is saved.
VITE_LOCAL_ASR_BASE_URL=
VITE_LOCAL_ASR_LANGUAGE=fr

# Optional local digital-PDF text extraction sidecar based on PyMuPDF.
VITE_LOCAL_DOCUMENT_BASE_URL=
