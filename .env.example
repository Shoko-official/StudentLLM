# Provider configuration is read at runtime and must not be committed with values.
# On Windows, set NVIDIA_API_KEY in the User environment scope.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-4b
# Optional browser chat endpoint; do not put credentials in VITE_* variables.
VITE_LM_STUDIO_BASE_URL=
VITE_LM_STUDIO_MODEL=qwen/qwen3-4b
